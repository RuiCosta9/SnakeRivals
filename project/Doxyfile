PROJECT_NAME           = "Snake Rivals"
PROJECT_BRIEF          = "LCOM final project documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

INPUT                  = docs/mainpage.md \
                         src/app \
                         src/states \
                         src/game \
                         src/multiplayer \
                         src/render \
                         src/ui \
                         src/resources \
                         ../lab2/timer.h \
                         ../lab3/kbc.h \
                         ../lab4/mouse.h \
                         ../lab5/video.h \
                         ../lab5/vbe.h

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
RECURSIVE              = YES
FILE_PATTERNS          = *.c \
                         *.h \
                         *.md
EXCLUDE                = src/render/xpms
EXCLUDE_PATTERNS       = */xpms/* \
                         *.xpm

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
INCLUDE_PATH           = src \
                         src/app \
                         src/states \
                         src/game \
                         src/render \
                         src/ui \
                         src/multiplayer \
                         src/resources \
                         ../lab2 \
                         ../lab3 \
                         ../lab4 \
                         ../lab5

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

QUIET                  = NO
JAVADOC_AUTOBRIEF      = NO
MULTILINE_CPP_IS_BRIEF = NO
